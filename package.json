{
  "name": "wordle-discord-activity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server.js",
    "dev:client": "vite --host 0.0.0.0 --root client",
    "build": "vite build --root client --outDir ../dist",
    "start": "node server.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.4.1",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "concurrently": "^8.2.2",
    "express": "^4.18.3",
    "vite": "^5.2.0"
  }
}
