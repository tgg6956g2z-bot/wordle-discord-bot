# Public Discord application ID from Developer Portal > OAuth2 > Client information
VITE_DISCORD_CLIENT_ID=your_discord_application_client_id

# Private seed used by the server to generate today's word.
# Keep this secret and do not change it unless you want to change the daily sequence.
WORDLE_DAILY_SEED=replace-with-a-long-private-random-string

# Railway supplies PORT automatically. For local server testing:
PORT=3000
